generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  admin
  editor
  viewer
}

enum Status {
  not_started
  in_progress
  complete
  delayed
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash       String
  role               Role       @default(viewer)
  mustChangePassword Boolean    @default(true)
  createdAt          DateTime   @default(now())
  outcomes           Outcome[]
}

model FocusArea {
  id        String    @id
  name      String
  sltLead   String
  outcomes  Outcome[]
}

model Outcome {
  id               String   @id
  focusAreaId      String
  focusArea        FocusArea @relation(fields: [focusAreaId], references: [id])
  isValid          Boolean  @default(true)
  title            String
  benefit          String?
  startingPoint    String?
  department       String?
  reportedToOpex   String?
  responsibleUserId Int?
  responsibleUser  User?    @relation(fields: [responsibleUserId], references: [id])
  riskLevel        String?
  riskIfNot        String?
  targetDate       String?
  desiredOutcome   String?
  milestoneCount   Int?
  actions          String?
  status           Status   @default(not_started)
  reasonForDelay   String?
  completePct      Float    @default(0)
  notes            String?
  archived         Boolean  @default(false)
  milestones       Milestone[]
}

model Milestone {
  id          Int      @id @default(autoincrement())
  outcomeId   String
  outcome     Outcome  @relation(fields: [outcomeId], references: [id])
  description String
  targetDate  String?
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
}

model OpexReview {
  id                   Int      @id @default(autoincrement())
  focusArea            String
  stream               String?
  reviewDate           String?
  reviewedBy           String?
  keyDiscussionPoints  String?
  actionsAgreed        String?
  nextSteps            String?
  personResponsible    String?
  dateClosed           String?
  opexSignOff          String?
}
